Grammar

    0 $accept: function $end

    1 function: function_header optional_variable body

    2 function_header: FUNCTION IDENTIFIER optional_parameters RETURNS type ';'
    3                | FUNCTION error ';'

    4 optional_parameters: parameters
    5                    | ε

    6 parameters: parameters ',' parameter
    7           | parameter

    8 parameter: IDENTIFIER ':' type

    9 type: INTEGER
   10     | REAL
   11     | CHARACTER

   12 optional_variable: optional_variable variable
   13                  | variable
   14                  | ε

   15 variable: IDENTIFIER ':' type IS statement ';'
   16         | IDENTIFIER ':' LIST OF type IS list ';'
   17         | error_recovery

   18 list: '(' expressions ')'

   19 expressions: expression
   20            | expressions ',' expression

   21 body: BEGIN_ statement_ END ';'

   22 statement_: ε
   23           | statement_ statement ';'
   24           | statement_ error_recovery

   25 error_recovery: error ';'

   26 inner_statement_check: statement ';'
   27                      | error_recovery

   28 statement: IF condition THEN inner_statement_check optional_elsif ELSE inner_statement_check ENDIF
   29          | WHEN condition ',' expression ':' expression
   30          | SWITCH expression IS cases OTHERS ARROW statement ';' ENDSWITCH
   31          | FOLD direction operator list_choice ENDFOLD
   32          | expression

   33 optional_elsif: optional_elsif ELSIF condition THEN inner_statement_check
   34               | ELSIF condition THEN inner_statement_check
   35               | ε

   36 cases: ε
   37      | cases case

   38 case: CASE INT_LITERAL ARROW statement ';'
   39     | CASE INT_LITERAL ARROW error_recovery
   40     | CASE error ARROW statement ';'
   41     | CASE error ARROW error_recovery

   42 direction: LEFT
   43          | RIGHT

   44 operator: ADDOP
   45         | MULOP
   46         | REMOP
   47         | EXPOP

   48 list_choice: list
   49            | IDENTIFIER

   50 condition: or_condition

   51 or_condition: or_condition OROP and_condition
   52             | and_condition

   53 and_condition: and_condition ANDOP not_unary
   54              | not_unary

   55 not_unary: NOTOP not_unary
   56          | relation

   57 relation: '(' condition ')'
   58         | expression RELOP expression

   59 expression: expression ADDOP term
   60           | term

   61 term: term MULOP power
   62     | term REMOP power
   63     | power

   64 power: unary EXPOP power
   65      | unary

   66 unary: NEGOP unary
   67      | primary

   68 primary: '(' expression ')'
   69        | INT_LITERAL
   70        | CHAR_LITERAL
   71        | REAL_LITERAL
   72        | IDENTIFIER '(' expression ')'
   73        | IDENTIFIER


